  m_TableData:
  - m_Id: 1312862208
    m_Localized: "\u041F\u043E\u043A\u0440\u0443\u0442\u0438 \u043A\u043E\u043B\u0435\u0441\u0438\u043A\u043E\u043C
      \u043C\u044B\u0448\u0438 - \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1367388160
    m_Localized: "\u041F\u043E\u0434\u0443\u0448\u0435\u0447\u043A\u0430! \u041E\u043D\u0430
      \u043C\u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 1367388161
    m_Localized: "\u0410 \u0447\u0442\u043E, \u0435\u0441\u043B\u0438 \u043F\u0443\u043B\u044C\u043D\u0443\u0442\u044C
      \u0432 \u0440\u0430\u043A\u0435\u0442\u0443?\n\u041E\u043D\u0430 \u043F\u043E\u043B\u0435\u0442\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 1367388162
    m_Localized: "\u0417\u0430\u0431\u044B\u043B \u043A\u0443\u0434\u0430 \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C
      - \u043E\u0442\u043A\u0440\u043E\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E
      \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 TAB"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582464
    m_Localized: "\u041F\u0420\u041E\u0411\u0415\u041B - \u043F\u0440\u044B\u0436\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582465
    m_Localized: "\u042F \u0441\u043C\u043E\u0433\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0441\u0435\u0431\u044F \u0438 \u0441\u0442\u0430\u0442\u044C \u0448\u0435\u0440\u0438\u0444\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582466
    m_Localized: "\u0411\u0430\u0445! \u0411\u0430\u0431\u0430\u0445! \n\u0425\u044D-\u0445\u044D!"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582467
    m_Localized: "\u0410 \u0447\u0442\u043E, \u0435\u0441\u043B\u0438 \u043C\u043D\u0435
      \u043D\u0443\u0436\u043D\u043E \u0441\u0442\u0440\u0435\u043B\u044C\u043D\u0443\u0442\u044C
      \u0432\u0432\u0435\u0440\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582468
    m_Localized: "WASD - \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582469
    m_Localized: "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C
      \u043F\u043E\u0434\u0443\u0448\u043A\u0443 \u043A\u043B\u0430\u0432\u0438\u0448\u0435\u0439
      F"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582470
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 TAB - \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582471
    m_Localized: "\u041F\u043E\u043A\u0440\u0443\u0442\u0438 \u043A\u043E\u043B\u0435\u0441\u0438\u043A\u043E\u043C
      \u043C\u044B\u0448\u0438 - \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u0447\u0442\u043E \u0432\u043E\u043A\u0440\u0443\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582472
    m_Localized: "\u0417\u0430\u0431\u044B\u043B \u043A\u0443\u0434\u0430 \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C
      - \u043E\u0442\u043A\u0440\u043E\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E
      \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 TAB"
    m_Metadata:
      m_Items: []
  - m_Id: 1371582473
    m_Localized: "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C
      \u043F\u043E\u0434\u0443\u0448\u043A\u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      - \u043D\u0430\u0436\u043C\u0438 F"
    m_Metadata:
      m_Items: []
