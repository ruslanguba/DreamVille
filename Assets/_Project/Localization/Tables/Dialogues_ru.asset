--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 92cb2097d87e0894daf04a7c0f3b8b50, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 658550784
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u044F \u041F\u043B\u044E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 717271040
    m_Localized: "\u0410 \u044F \u0442\u0443\u0442 \u044D\u0442\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443
      \u043F\u0438\u0441\u0430\u043B \u0432\u0441\u044E \u043D\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 717271041
    m_Localized: "\u041D\u0443 \u0434\u0430\u0432\u0430\u0439 \u043F\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1212198912
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u041F\u043B\u044E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1212198913
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u041D\u0435\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1212198914
    m_Localized: "\u0414\u0443\u0439 \u0432 \u043F\u043E\u0440\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1455468544
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u041F\u043B\u044E\u0445,
      \u0432\u0441\u0435\u0445 \u043F\u043E\u0439\u043C\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 1455468545
    m_Localized: "\u0414\u0430! \u042D\u0442\u043E\u0442 \u0441\u043E\u043D \u043E\u0447\u0438\u0449\u0435\u043D
      \u043E\u0442 \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 1455468546
    m_Localized: "\u041F\u0440\u044B\u0433\u0430\u0439 \u0432 \u0447\u0430\u0441\u044B,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0441\u043E\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 1929424896
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u041F\u043B\u044E\u0445! \n\u041F\u043E\u0440\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u0447\u0435\u043C\u0443-\u0442\u043E \u043D\u043E\u0432\u043E\u043C\u0443.\n\u041F\u0440\u044B\u0433\u0430\u0439
      \u0432 \u0447\u0430\u0441\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 2420158464
    m_Localized: "\u0420\u0430\u0434 \u0442\u0435\u0431\u044F \u0441\u043D\u043E\u0432\u0430
      \u0432\u0438\u0434\u0435\u0442\u044C, \u041F\u043B\u044E\u0445. \u0422\u044B
      \u0432\u0441\u0435 \u0437\u043D\u0430\u0435\u0448\u044C, \u043F\u0440\u044B\u0433\u0430\u0439
      \u0432 \u0447\u0430\u0441\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 2902503424
    m_Localized: "\u041F\u043B\u044E\u0445! \u041A\u0430\u043A \u0432\u044B\u0441\u043E\u043A\u043E
      \u0442\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F! \u041A\u0430\u043A
      \u0443\u0441\u043F\u0435\u0445\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2902503425
    m_Localized: "\u0412\u0441\u0435\u0445 \u043F\u043E\u0439\u043C\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2902503426
    m_Localized: "\u0423\u0445, \u0448\u0443\u0441\u0442\u0440\u044F\u043A! \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0447\u043A\u043E\u0432 \u0442\u044B
      \u043D\u0430\u0431\u0440\u0430\u043B... \u041E\u0433\u043E, \u0441\u043E\u043B\u0438\u0434\u043D\u043E!
      \n\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C, \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0435\u0449\u0451 \u0440\u0430\u0437
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442! "
    m_Metadata:
      m_Items: []
  - m_Id: 2902503427
    m_Localized: "\u0423 \u043D\u0430\u0441 \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0437\u0430\u0434\u0430\u043D\u0438\u0439
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E
      \u0437\u0430 \u0441\u043B\u0443\u0436\u0431\u0443! "
    m_Metadata:
      m_Items: []
  - m_Id: 3393236992
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u041F\u043B\u044E\u0445!
      \u0417\u0430\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0430 \u0441\u043C\u0435\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 3393236993
    m_Localized: "\u0414\u0430, \u043C\u043E\u0435\u043C\u0443 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0443
      \u0441\u043D\u043E\u0432\u0430 \u0441\u043D\u044F\u0442\u0441\u044F \u043A\u043E\u0448\u043C\u0430\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 3393236994
    m_Localized: "\u041D\u0443, \u043F\u043E\u043B\u0443\u0447\u0430\u0439 \u0441\u0432\u043E\u0439
      \u043F\u043E\u0434\u0443\u0448\u043A\u043E\u043C\u0435\u0442. \u041D\u0430\u043F\u043E\u043C\u043D\u0438,
      \u043A\u0430\u043A \u0442\u044B  \u0435\u0433\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 3393236995
    m_Localized: "\u041C\u043E\u044F \u0442\u0438\u0445\u043E\u0431\u043E\u0439\u043A\u0430 
      \u0425\u0430\u0445\u0430\u0445\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 3393236996
    m_Localized: "\u0422\u0430\u043A \u0434\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043C
      \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436, \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F
      \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430, \u043D\u0443 \u0442\u044B
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 3393236997
    m_Localized: "\u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 3393236998
    m_Localized: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u0441\u043D\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
      \u0438 \u041F\u041E\u0419\u041C\u0410\u0419 \u0432 \u043D\u0435\u043C \u0412\u0421\u0415\u0425
      \u041A\u041E\u0428\u041C\u0410\u0420\u0418\u041A\u041E\u0412. \u0412 \u0432\u0435\u0440\u0445\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443 \u0443\u0441\u0442\u044C \u0421\u0427\u0415\u0422\u0427\u0418\u041A
      \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u043E\u0432, \u0442\u044B
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u043E\u0432
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0439\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 3393236999
    m_Localized: "\u041E, \u044D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u043E\u0435,
      \u0443\u0434\u043E\u0431\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 3393237000
    m_Localized: "\u041F\u043E \u0422\u0438\u0445\u043E\u0431\u043E\u0439\u043A\u0435
      \u0432\u0441\u0435 \u043F\u043E \u0441\u0442\u0430\u0440\u043E\u043C\u0443.
      \u041F\u0420\u0410\u0412\u0410\u042F \u041A\u041E\u041D\u041E\u041F\u041A\u0410
      \u043C\u044B\u0448\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F,
      \u041B\u0415\u0412\u0410\u042F \u0441\u0442\u0440\u0435\u043B\u044C\u043D\u0443\u0442\u044C. 
      \u041D\u0430 \u041F\u0420\u041E\u0411\u0415\u041B \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C. \u041A\u041E\u041B\u0415\u0421\u0418\u041A\u041E\u041C
      \u043C\u044B\u0448\u0438 \u043E\u0442\u0434\u0430\u043B\u0438\u0442\u044C \u0438\u043B\u0438
      \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C \u0432\u0438\u0434.
      \u0422\u0430\u043A \u0432\u0440\u043E\u0434\u0435 \u0432\u0441\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 3393237001
    m_Localized: "\u0422\u0438\u0445\u043E\u0431\u043E\u0439\u043A\u0430 \u043F\u043E
      \u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442
      \u0432\u0432\u0435\u0440\u0445 \u0438 \u0432\u043D\u0438\u0437, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u043F\u0435\u0440\u0435\u0434 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 3393237002
    m_Localized: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u0434\u0430. \u041D\u0430\u0448\u0438 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u044B
      \u0432\u0441\u0435 \u0435\u0449\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u043D\u0430\u0434 \u044D\u0442\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3393237003
    m_Localized: "\u041F\u043E\u043D\u044F\u043B, \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C,
      \u0441\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 3393237004
    m_Localized: "\u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0442\u0432\u043E\u0439 \u043D\u0430\u0441\u0442\u0440\u043E\u0439. \u0414\u0430\u0432\u0430\u0439
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u0442\u0432\u043E\u0438 \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u044B,
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443.
      \u041A\u0430\u043A \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F
      \u043A\u043E \u043C\u043D\u0435, \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
      \u043A\u043E\u0435 \u0447\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 3875581952
    m_Localized: "\u0422\u044B \u0433\u043E\u0442\u043E\u0432? \u041F\u0440\u044B\u0433\u0430\u0439
      \u0432 \u043F\u0435\u0441\u043E\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B
      \u0438 \u043F\u043E\u043F\u0430\u0434\u0451\u0448\u044C \u0432 \u0441\u043D\u043E\u0432\u0438\u0434\u0435\u043D\u0438\u0435.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u0439\u043C\u0430\u0435\u0448\u044C
      \u0432\u0441\u0435\u0445 \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u043E\u0432,
      \u043D\u0430\u0439\u0434\u0438 \u043C\u0435\u043D\u044F. "
    m_Metadata:
      m_Items: []
  - m_Id: 3875581953
    m_Localized: "\u0418 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435.
      \u0415\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0437\u0430\u0431\u0443\u0434\u0435\u0448\u044C,
      \u043D\u0430\u0436\u043C\u0438 TAB, \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F
      \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F. \u0423\u0434\u0430\u0447\u0438,
      \u041F\u043B\u044E\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 4106268672
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043D\u043E\u0432\u043E\u0431\u0440\u0430\u043D\u0435\u0446!
      \n\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u044B\u0439
      \u043B\u0430\u0433\u0435\u0440\u044C \u043C\u0438\u0440\u0430 \u0441\u043D\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 4336955392
    m_Localized: "\u0410 \u043A\u0430\u043A \u0441\u0442\u0430\u0442\u044C \u0448\u0435\u0440\u0438\u0444\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4336955393
    m_Localized: "\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0439 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u0432\u0435\u0437\u0434 - \u0441\u0442\u0430\u043D\u0435\u0448\u044C
      \u0448\u0435\u0440\u0438\u0444\u043E\u043C!\n\u041F\u043E\u043B\u0443\u0447\u0430\u0439
      \u043E\u0447\u043A\u0438 \u0437\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u0435
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B. \n\u0411\u043E\u043B\u044C\u0448\u0435
      \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u043E\u0432 - \u0431\u043E\u043B\u044C\u0448\u0435
      \u043E\u0447\u043A\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 4336955394
    m_Localized: "\u042F \u0432 \u0434\u0435\u043B\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 4571836416
    m_Localized: "\u041F\u043B\u044E\u0445, \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0441\u043D\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
      \u043D\u043E\u0432\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442.\n\u0412\u0438\u0436\u0443,
      \u0442\u044B \u0443\u0436\u0435 \u043D\u0430\u0448\u0435\u043B \u043E\u0434\u043D\u0443
      \u043F\u043E\u0434\u0443\u0448\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4571836417
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      - \u044D\u0442\u043E \u043F\u043E\u0434\u0443\u0448\u043A\u0430? \u0425\u0430-\u0445\u0430-\u0445\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 4571836418
    m_Localized: "\u041F\u043E\u0434\u0443\u0448\u043A\u0430 - \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430,
      \u0434\u0430! \n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0435\u0451,
      \u0435\u0441\u043B\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
      \u0434\u043E\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C.\n\u041F\u0440\u043E\u0445\u043E\u0434\u0438
      \u0432 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u0443\u044E
      \u0437\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 5049987072
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u041F\u043B\u044E\u0445,
      \u0432\u0441\u0435\u0445 \u043F\u043E\u0439\u043C\u0430\u043B ?"
    m_Metadata:
      m_Items: []
  - m_Id: 5049987073
    m_Localized: "\u0412\u0441\u0435\u0445. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043C\u043E\u0436\u043D\u043E \u0441\u043F\u0430\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 5049987074
    m_Localized: "\u041D\u0443 \u0442\u043E\u0433\u0434\u0430 \u043F\u0440\u044B\u0433\u0430\u0439
      \u0432 \u043C\u043E\u0438 \u0447\u0430\u0441\u044B \u0438 \u043F\u043E\u043B\u0435\u0442\u0435\u043B\u0438
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5523943424
    m_Localized: "\u041F\u043B\u044E\u0445! \u041A\u0430\u043A \u0432\u044B\u0441\u043E\u043A\u043E
      \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F. \u041A\u0430\u043A \u0434\u0435\u043B\u0430
      \u0441 \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u0430\u043C\u0438 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 5523943425
    m_Localized: "\u0421\u043B\u0430\u0434\u043A\u043E \u0441\u043F\u044F\u0442.
      \u0422\u0443\u0442 \u0432\u0441\u0435\u0445 \u043F\u043E\u0439\u043C\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 5523943426
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C\u0441\u044F.
      \u0423 \u043D\u0430\u0441 \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0437\u0430\u0434\u0430\u043D\u0438\u0439
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442. \u0421\u043F\u0430\u0441\u0438\u0431\u043E
      \u0437\u0430 \u0441\u043B\u0443\u0436\u0431\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6010482688
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u041F\u043B\u044E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 6010482689
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u041D\u0435\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6010482690
    m_Localized: "\u0414\u0443\u0439 \u0432 \u043F\u043E\u0440\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6501216256
    m_Localized: "\u041F\u043B\u044E\u0445, \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0432\u044B\u0434\u0430\u0442\u044C \u0442\u0435\u0431\u0435 \u043D\u043E\u0432\u044B\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6501216257
    m_Localized: "\u0423\u0445 \u0442\u044B! \u0418 \u0447\u0442\u043E \u044D\u0442\u043E
      \u0431\u0443\u0434\u0435\u0442 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6501216258
    m_Localized: "\u041D\u0438 \u0437\u0430 \u0447\u0442\u043E \u043D\u0435 \u0443\u0433\u0430\u0434\u0430\u0435\u0448\u044C.
      \u041F\u041E\u0414\u0423\u0428\u041A\u0410-\u041F\u041B\u0410\u0422\u0424\u041E\u0420\u041C\u0410,
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u0442\u044C
      \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F. \u041D\u0435
      \u043C\u043E\u0436\u0435\u0448\u044C \u0434\u043E\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C
      - \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043F\u043E\u0434\u0443\u0448\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6501216259
    m_Localized: "\u0417\u0432\u0443\u0447\u0438\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E.
      \u041A\u0430\u043A \u0435\u0439 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6501216260
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 R - \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043F\u043E\u0434\u0443\u0448\u043A\u0443, \u043D\u0430\u0436\u043C\u0438
      \u0435\u0449\u0435 \u0440\u0430\u0437 R \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043F\u043E\u0434\u0443\u0448\u043A\u0443 \u043D\u0430 \u043D\u0443\u0436\u043D\u043E\u043C
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438, \u043D\u0430\u0436\u043C\u0438
      F \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u043F\u043E\u0434\u0443\u0448\u043A\u0443. \u041F\u043E\u043A\u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0442\u0435\u0441\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0438 \u043D\u0430\u043C
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u043E \u0432\u044B\u0434\u0430\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u0434\u0432\u0435 \u043F\u043E\u0434\u0443\u0448\u043A\u0438
      \u043D\u0430 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F.."
    m_Metadata:
      m_Items: []
  - m_Id: 6501216261
    m_Localized: "\u041A\u0430\u043A \u0436\u0435 \u043C\u043D\u0435 \u0435\u0435
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u043B\u043E. "
    m_Metadata:
      m_Items: []
  - m_Id: 6501216262
    m_Localized: "\u041E\u0441\u0432\u0430\u0438\u0432\u0430\u0439\u0441\u044F. \u0414\u0435\u0440\u0436\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E \u0441 \u0441\u043E\u0431\u043E\u0439,
      \u0432\u0441\u0435 \u0442\u0430\u043A\u0436\u0435 \u043D\u0430 TAB. \u0414\u043E\u0431\u0435\u0440\u0438\u0441\u044C
      \u0434\u043E \u043C\u043E\u0438\u0445 \u0447\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
